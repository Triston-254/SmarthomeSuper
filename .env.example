# Frontend (React) variables
# Default API_BASE is same-origin "/api". Set this only for local dev
# where the backend runs on a separate port (e.g. http://localhost:5000/api).
REACT_APP_API_BASE=

# Backend (Node/Express) variables
PORT=5000
JWT_SECRET=change-me-in-production

# Required on Vercel Project Settings → Environment Variables
# Use the Supabase connection string (Session pooler preferred for serverless):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
